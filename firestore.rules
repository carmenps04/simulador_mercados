rules_version = '2';

// Reglas de Firestore del proyecto «simulador-maes».
// Este archivo NO se aplica solo: hay que pegarlo en la consola de Firebase
// (Firestore Database → Reglas → Publicar) para que tenga efecto.
// Cualquier dispositivo con sesión (anónima) puede leer y escribir las partidas,
// porque grupos y profesorado comparten los mismos datos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /mercado-movil/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
